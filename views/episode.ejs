<%- include("partials/header.ejs") %>

            <div class="container">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card mb-3 border-5" style="width: 100%;">
                            <div class="card-body black-background">
                                <h4 class="card-title green-font">Find your episode</h4>
                                <form action="/episode/filter" id="form" class="form" method="POST">
                                  <input type="text" class="form-control border-black" name="episodeName" placeholder="What is the episode called?">
                                  <input type="text" class="form-control border-black" name="episodeCode" placeholder="What is the episode's code?">
                                  <button type="submit" class="form-submit green-btn btn">Search</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                  <% episodes.forEach(episode => { %>
                    <div class="col-md-3">
                        <div class="card black-background mb-3 border-5 border-white" style="width: 100%;">
                            <div class="card-body">
                                <h5 class="card-title green-font"><%= episode.name %></h5>
                                <p class="card-text">The code of this episode is: <br /><%= episode.code %></p>
                                <p class="card-text">And it was aired: <br /> <%= episode.airDate %></p>
                                <a href="/episode/<%= episode.id %>" class="card-link green-font">View featured characters</a>
                            </div>
                        </div>
                    </div>
                  <% }); %> 
                </div>
            </div>

<%- include("partials/footer.ejs") %>