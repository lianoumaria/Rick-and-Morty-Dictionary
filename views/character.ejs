<%- include("partials/header.ejs") %>

            <div class="container">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card mb-3 border-5" style="width: 100%;">
                            <div class="card-body black-background">
                                <h4 class="card-title green-font">Find your character</h4>
                                <form action="/character/filter" id="form" class="form" method="POST">
                                  <input type="text" class="form-control border-black" name="characterName" placeholder="What is the character's name?">
                                  <input type="text" class="form-control border-black" name="characterSpecies" placeholder="What species does the character belong to?">
                                  <select name="characterGenter" class="form-select">
                                    <option value="">What is the gender of the character?</option>
                                    <option value="unknown">unknown</option>
                                    <option value="female">female</option>
                                    <option value="male">male</option>
                                    <option value="genderless">genderless</option>
                                  </select>
                                  <button type="submit" class="form-submit green-btn btn">Search</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                  <% characters.forEach(character => { %>
                    <div class="col-md-6">
                       <div class="card  black-background mb-3 border-5 border-white" style="max-width: 100%;">
                          <div class="row g-0" style="justify-content: space-between;">
                            <div class="col-4">
                              <img src=<%= character.image %> class="img-fluid rounded-start" alt="...">
                            </div>
                            <div class="col-8">
                              <div class="card-body">
                                <h5 class="card-title green-font"><%= character.name %></h5>
                                <p class="card-text">Character's origin: <%= character.origin %></p>
                                <p class="card-text">Character's last known location: <%= character.location %></p>
                                <p class="card-text">Belongs to <%= character.species %> species</p>
                              </div>
                            </div>
                          </div>
                        </div>
                    </div>
                  <% }); %> 
                </div>
            </div>

<%- include("partials/footer.ejs") %>